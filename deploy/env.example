# =============================================================================
# GLI PFT API — environment file for production
# =============================================================================
# Copy to the SERVER (not inside your git repo):
#
#   sudo mkdir -p /etc/gli-pft
#   sudo cp deploy/env.example /etc/gli-pft/env
#   sudo nano /etc/gli-pft/env
#
# systemd loads this via:  EnvironmentFile=/etc/gli-pft/env
# (see deploy/gli-pft-api.service)
# =============================================================================

# Project root on the server — Python must find the "backend" package from here
PYTHONPATH=/opt/gli-pft/GLI-pulmonary-measurment

# Browser origins allowed to call the API (comma-separated, no spaces)
# Use your public HTTPS URL. Same-origin deploy via Nginx still benefits from setting this.
ALLOWED_ORIGINS=https://your-domain.com
